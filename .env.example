# Copy to .env.local (never committed) and adjust. Only NEXT_PUBLIC_* values reach the browser — this app has no secrets.

# Public origin of the deployment, no trailing slash. Used for metadataBase (absolute Open Graph / Twitter image URLs),
# canonical links, sitemap.xml, robots.txt and JSON-LD. When it starts with https:// the CSP also adds
# upgrade-insecure-requests — so leave it empty for local `next start` over http. Empty/unset → http://localhost:3000.
# Vercel: set it per environment (Production → your domain; Preview → leave unset or use the preview URL).
NEXT_PUBLIC_SITE_URL=

# Audit / Lighthouse (scripts only, optional)
# AUDIT_PORT=3100                      # port `npm run audit` starts `next start` on
# AUDIT_BASE_URL=http://localhost:3000 # audit an already-running server instead
# AUDIT_ONLY=crawl,links,buttons,flows,a11y,seo
# AUDIT_FLOW=<regex>                   # only flows whose name matches
# AUDIT_CONCURRENCY=6
# LH_BASE_URL=http://localhost:3200    # server `npm run lighthouse` tests
# LH_RUNS=3                            # runs per page × preset; median kept
